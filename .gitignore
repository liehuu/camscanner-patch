# 构建中间产物
build/
work/
out/
DerivedData/

# 注入前的二进制备份
*.orig
*_testbin

# 编译产物
*.dylib
*.o
*.dSYM/

# Python
__pycache__/
*.pyc

# 系统
.DS_Store
Thumbs.db

# 注意：刻意「不」忽略 in/*.ipa
# CI 需要 checkout 到原始包才能解包注入。若不想把 167MB 提交进仓库，
# 用 workflow_dispatch 的 ipa_url 输入直接从私有 Release / 直链下载。
# 临时比对文件（与远端源码做字节 diff 时产生）
remote_src.m

# 交付产物目录（从 CI artifact 下载解包而来，绝不入库）
dist/

# 本地门禁 / 推送 / 打包日志 —— 一次性诊断产物，不入库。
# 每次改动都会生成一份新的，入库只会让 diff 变噪音。
*.log

# acrimmp 临时验证脚本（本地跑 IMP 签名对照用）
tmpacrimmp*.m
